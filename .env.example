# Variables à saisir dans Portainer (stack → Environment variables).
# Ce fichier ne contient que des exemples : aucune vraie valeur dans le dépôt.

# Mot de passe commun à toutes les applis (12 caractères au moins)
APPS_PASSWORD=change-moi-12-caracteres-minimum

# Dossier du NAS pour l'Anneau : on y pose services.yaml (voir app/services.exemple.yaml)
ANNEAU_DATA_DIR=/volume1/docker/anneau

# Secret partagé avec Home Assistant, qui le joint à ses envois (en-tête X-Anneau-Secret).
# Vide : l'Anneau n'attend pas Home Assistant et ne surveille aucun volume.
ANNEAU_SECRET_HA=

# Facultatif
# PORT_ANNEAU=8094
