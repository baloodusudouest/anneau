# Variables à saisir dans Portainer (stack → Environment variables).
# Ce fichier ne contient que des exemples : aucune vraie valeur dans le dépôt.

# Mot de passe commun à toutes les applis maison (12 caractères au moins)
MAISON_PASSWORD=change-moi-12-caracteres-minimum

# Jeton commun entre applis maison : annuaire des adresses, collecte des sauvegardes, « Restaurer » des applis.
# Vide : ces portes sont fermées et la collecte ne demande rien.
MAISON_JETON=
# Clé de lecture de l'Anneau (contrat 3) : n'ouvre que les fiches « Connexion ». Vide : l'Anneau ne les lit pas.
ANNEAU_CLE=

# Dossier du NAS pour l'Anneau : services.yaml, réglages, sauvegardes (à inclure dans Hyper Backup)
ANNEAU_DATA_DIR=/volume1/docker/anneau

# Secret partagé avec Home Assistant, qui le joint à ses envois (en-tête X-Anneau-Secret).
# Vide : l'Anneau n'attend pas Home Assistant et ne surveille aucun volume.
ANNEAU_SECRET_HA=

# Atlas dans l'Anneau (facultatif) : dépôt « propriétaire/atlas » et jeton GitHub en lecture seule
ANNEAU_ATLAS_DEPOT=
ANNEAU_GITHUB_JETON=

# 0.17 : allumer, éteindre, mettre à jour depuis l'Anneau les conteneurs des tuiles marquées « conteneur: » (Portainer CE).
# Vide : pas de boutons. Clé d'API d'un utilisateur Portainer standard « anneau » (jamais la clé admin) : voir REPRISE.md.
ANNEAU_PORTAINER_URL=
ANNEAU_PORTAINER_CLE=
# Numéro de l'environnement Docker dans Portainer ; vide : le premier environnement Docker local trouvé
ANNEAU_PORTAINER_ENV=
# « oui » : l'Anneau ne donne aucun ordre (MAISON_LECTURE_SEULE=oui fait de même pour toutes les applis)
# ANNEAU_LECTURE_SEULE=

# Facultatif
# PORT_ANNEAU=8094
